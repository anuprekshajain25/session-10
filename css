
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #e8efff, #f7eaff);
    color: #20243a;
}

.quiz-card {
    width: 100%;
    max-width: 680px;
    background: white;
    padding: 30px;
    border-radius: 20px;
    box-shadow: 0 15px 45px rgba(40,45,90,.13);
}

h1 {
    margin-bottom: 8px;
}

.subtitle {
    color: #68708a;
}

.topline {
    display: flex;
    justify-content: space-between;
    margin-top: 25px;
    color: #68708a;
}

.progress {
    height: 9px;
    background: #edf0f8;
    border-radius: 20px;
    overflow: hidden;
    margin: 15px 0 25px;
}

.progress-fill {
    height: 100%;
    width: 0;
    background: #6b63df;
    transition: width .25s;
}

#question {
    font-size: 22px;
    line-height: 1.4;
}

.answers {
    display: grid;
    gap: 12px;
}

.answer {
    width: 100%;
    text-align: left;
    padding: 15px;
    border: 2px solid #e5e8f2;
    border-radius: 12px;
    background: white;
    color: #252943;
    font-size: 16px;
    cursor: pointer;
    transition: 0.2s;
}

.answer:hover:not(:disabled) {
    border-color: #8179ed;
    background: #f8f7ff;
}

.answer:disabled {
    cursor: default;
    opacity: 1;
}

.answer.correct {
    border-color: #219866;
    background: #eaf8f1;
}

.answer.wrong {
    border-color: #d94c5c;
    background: #fff0f1;
}

#feedback {
    min-height: 28px;
    margin-top: 18px;
    font-weight: bold;
}

button.primary {
    border: none;
    border-radius: 10px;
    padding: 13px 22px;
    background: #625bd5;
    color: white;
    font-weight: bold;
    font-size: 16px;
    cursor: pointer;
    transition: 0.2s;
}

button.primary:hover:not(:disabled) {
    background: #4e47bd;
}

button.primary:disabled {
    background: #b9b7d9;
    cursor: not-allowed;
}

.actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 15px;
}

.result {
    text-align: center;
    padding: 20px 0;
}

.result-score {
    font-size: 50px;
    font-weight: bold;
    color: #625bd5;
    margin: 15px;
}

.hidden {
    display: none;
}

/* Mobile responsive design */

@media (max-width: 480px) {
    .quiz-card {
        padding: 20px;
    }

    #question {
        font-size: 19px;
    }

    .answer {
        font-size: 15px;
    }
}
