
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>General Knowledge Quiz</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #e8efff, #f7eaff);
    color: #20243a;
}

.quiz-card {
    width: 100%;
    max-width: 680px;
    background: white;
    padding: 30px;
    border-radius: 20px;
    box-shadow: 0 15px 45px rgba(40,45,90,.13);
}

h1 {
    margin-bottom: 8px;
}

.subtitle {
    color: #68708a;
}

.topline {
    display: flex;
    justify-content: space-between;
    margin-top: 25px;
    color: #68708a;
}

.progress {
    height: 9px;
    background: #edf0f8;
    border-radius: 20px;
    overflow: hidden;
    margin: 15px 0 25px;
}

.progress-fill {
    height: 100%;
    width: 0;
    background: #6b63df;
    transition: width .25s;
}

#question {
    font-size: 22px;
    line-height: 1.4;
}

.answers {
    display: grid;
    gap: 12px;
}

.answer {
    width: 100%;
    text-align: left;
    padding: 15px;
    border: 2px solid #e5e8f2;
    border-radius: 12px;
    background: white;
    color: #252943;
    font-size: 16px;
    cursor: pointer;
}

.answer:hover:not(:disabled) {
    border-color: #8179ed;
    background: #f8f7ff;
}

.answer:disabled {
    cursor: default;
    opacity: 1;
}

.answer.correct {
    border-color: #219866;
    background: #eaf8f1;
}

.answer.wrong {
    border-color: #d94c5c;
    background: #fff0f1;
}

#feedback {
    min-height: 28px;
    margin-top: 18px;
    font-weight: bold;
}

button.primary {
    border: none;
    border-radius: 10px;
    padding: 13px 22px;
    background: #625bd5;
    color: white;
    font-weight: bold;
    font-size: 16px;
    cursor: pointer;
}

button.primary:disabled {
    background: #b9b7d9;
    cursor: not-allowed;
}

.actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 15px;
}

.result {
    text-align: center;
    padding: 20px 0;
}

.result-score {
    font-size: 50px;
    font-weight: bold;
    color: #625bd5;
    margin: 15px;
}

.hidden {
    display: none;
}

@media(max-width:480px) {
    .quiz-card {
        padding: 20px;
    }
}
</style>
</head>

<body>

<main class="quiz-card">

<section id="quiz">

<h1>General Knowledge Quiz</h1>

<p class="subtitle">
Test yourself with 15 general knowledge questions!
</p>

<div class="topline">
    <span id="question-count">Question 1 of 15</span>
    <span id="score-count">Score: 0</span>
</div>

<div class="progress">
    <div class="progress-fill" id="progress-fill"></div>
</div>

<h2 id="question"></h2>

<div class="answers" id="answers"></div>

<p id="feedback"></p>

<div class="actions">
    <button class="primary" id="next-button" disabled>
        Next Question
    </button>
</div>

</section>

<section id="result" class="result hidden">

<h1>Quiz Completed!</h1>

<p>Your Final Score:</p>

<div class="result-score" id="final-score"></div>

<h2 id="result-message"></h2>

<p id="result-detail"></p>

<button class="primary" id="restart-button">
    Try Again
</button>

</section>

</main>

<script>

// QUIZ QUESTIONS

const questions = [

{
q: "What is the capital of Australia?",
a: ["Sydney", "Canberra", "Melbourne", "Perth"],
correct: 1
},

{
q: "Which planet is known as the Red Planet?",
a: ["Venus", "Jupiter", "Mars", "Mercury"],
correct: 2
},

{
q: "Who wrote the Indian national anthem?",
a: ["Bankim Chandra Chatterjee", "Rabindranath Tagore", "Sarojini Naidu", "Mahatma Gandhi"],
correct: 1
},

{
q: "What is the largest ocean on Earth?",
a: ["Atlantic Ocean", "Indian Ocean", "Arctic Ocean", "Pacific Ocean"],
correct: 3
},

{
q: "Which gas do plants absorb?",
a: ["Oxygen", "Carbon dioxide", "Nitrogen", "Hydrogen"],
correct: 1
},

{
q: "How many sides does a hexagon have?",
a: ["Five", "Six", "Seven", "Eight"],
correct: 1
},

{
q: "Which is the largest state in India by area?",
a: ["Madhya Pradesh", "Maharashtra", "Rajasthan", "Uttar Pradesh"],
correct: 2
},

{
q: "Who was the first person to walk on the Moon?",
a: ["Yuri Gagarin", "Buzz Aldrin", "Neil Armstrong", "Michael Collins"],
correct: 2
},

{
q: "What is the chemical symbol for gold?",
a: ["Ag", "Au", "Gd", "Go"],
correct: 1
},

{
q: "Which organ pumps blood around the human body?",
a: ["Lungs", "Brain", "Liver", "Heart"],
correct: 3
},

{
q: "In which year did India become independent?",
a: ["1945", "1947", "1950", "1952"],
correct: 1
},

{
q: "Which is the fastest land animal?",
a: ["Lion", "Horse", "Cheetah", "Leopard"],
correct: 2
},

{
q: "What is the currency of Japan?",
a: ["Won", "Yuan", "Yen", "Ringgit"],
correct: 2
},

{
q: "Which instrument measures temperature?",
a: ["Barometer", "Thermometer", "Hygrometer", "Altimeter"],
correct: 1
},

{
q: "What is the smallest prime number?",
a: ["0", "1", "2", "3"],
correct: 2
}

];

// VARIABLES

let current = 0;
let score = 0;
let answered = false;

// HTML ELEMENTS

const questionEl = document.getElementById("question");
const answersEl = document.getElementById("answers");
const feedbackEl = document.getElementById("feedback");
const nextButton = document.getElementById("next-button");

// DISPLAY QUESTION

function showQuestion() {

    answered = false;

    const item = questions[current];

    document.getElementById("question-count").textContent =
        `Question ${current + 1} of ${questions.length}`;

    document.getElementById("score-count").textContent =
        `Score: ${score}`;

    document.getElementById("progress-fill").style.width =
        `${(current / questions.length) * 100}%`;

    questionEl.textContent = item.q;

    feedbackEl.textContent = "";

    answersEl.innerHTML = "";

    nextButton.disabled = true;

    nextButton.textContent =
        current === questions.length - 1
        ? "See Results"
        : "Next Question";

    item.a.forEach((answer, index) => {

        const button = document.createElement("button");

        button.className = "answer";

        button.textContent =
            `${String.fromCharCode(65 + index)}. ${answer}`;

        button.addEventListener("click", () => {
            chooseAnswer(index);
        });

        answersEl.appendChild(button);

    });

}

// CHECK ANSWER

function chooseAnswer(selected) {

    if (answered) return;

    answered = true;

    const correct = questions[current].correct;

    const buttons = [...answersEl.children];

    buttons.forEach((button, index) => {

        button.disabled = true;

        if (index === correct) {
            button.classList.add("correct");
        }

        if (index === selected && selected !== correct) {
            button.classList.add("wrong");
        }

    });

    if (selected === correct) {

        score++;

        feedbackEl.textContent = "Correct! Well done.";

        feedbackEl.style.color = "#168253";

    } else {

        feedbackEl.textContent =
            `Incorrect! Correct answer: ${questions[current].a[correct]}`;

        feedbackEl.style.color = "#c13d4b";

    }

    document.getElementById("score-count").textContent =
        `Score: ${score}`;

    nextButton.disabled = false;

}

// NEXT QUESTION

nextButton.addEventListener("click", () => {

    if (!answered) return;

    current++;

    if (current < questions.length) {

        showQuestion();

    } else {

        showResult();

    }

});

// SHOW FINAL RESULT

function showResult() {

    document.getElementById("quiz").classList.add("hidden");

    document.getElementById("result").classList.remove("hidden");

    document.getElementById("progress-fill").style.width = "100%";

    document.getElementById("final-score").textContent =
        `${score} / ${questions.length}`;

    const percentage = (score / questions.length) * 100;

    let message;

    if (percentage >= 80) {
        message = "Excellent Work!";
    } else if (percentage >= 50) {
        message = "Good Effort!";
    } else {
        message = "Keep Practising!";
    }

    document.getElementById("result-message").textContent = message;

    document.getElementById("result-detail").textContent =
        `You answered ${score} correctly and ${questions.length - score} incorrectly.`;

}

// RESTART QUIZ

document.getElementById("restart-button").addEventListener("click", () => {

    current = 0;
    score = 0;

    document.getElementById("result").classList.add("hidden");

    document.getElementById("quiz").classList.remove("hidden");

    showQuestion();

});

// START QUIZ

showQuestion();

</script>

</body>
</html>
